---
import { siteConfig } from '../data/siteConfig';

interface Props {
  text?: string;
  href?: string;
  class?: string;
  showIcon?: boolean;
  target?: string;
  rel?: string;
}

const {
  text = "Chamar no WhatsApp",
  href = siteConfig.contact.whatsappUrl,
  class: className = "btn-wa",
  showIcon = true,
  target,
  rel,
} = Astro.props;
---

<a class={className} href={href} target={target} rel={rel}>
  {showIcon && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2A10 10 0 0 0 2 12a9.9 9.9 0 0 0 1.5 5.3L2 22l4.8-1.5A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-2.9.9.9-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.7.8c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.6-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.8 2 4.7 4.7 0 0 0 1 2.5 10.7 10.7 0 0 0 4.1 3.6 13.7 13.7 0 0 0 1.4.5 3.3 3.3 0 0 0 1.5.1 2.5 2.5 0 0 0 1.6-1.1 2 2 0 0 0 .2-1.1c-.1-.1-.3-.2-.5-.3z"/>
    </svg>
  )}
  {text}
</a>
