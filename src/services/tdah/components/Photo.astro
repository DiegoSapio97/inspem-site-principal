---
interface PhotoData {
  src: string;
  alt: string;
  width: number;
  height: number;
  mobile?: { src: string; width: number; height: number };
}

interface Props {
  photo: PhotoData;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const { photo, loading, fetchpriority, class: className } = Astro.props;
---

{photo.mobile ? (
  <picture>
    <source media="(max-width: 600px)" srcset={photo.mobile.src} type="image/avif" width={photo.mobile.width} height={photo.mobile.height} />
    <img
  src={photo.src}
  alt={photo.alt}
  width={photo.width}
  height={photo.height}
  loading={loading}
  fetchpriority={fetchpriority}
  class={className}
/>
  </picture>
) : (
  <img
  src={photo.src}
  alt={photo.alt}
  width={photo.width}
  height={photo.height}
  loading={loading}
  fetchpriority={fetchpriority}
  class={className}
/>
)}
