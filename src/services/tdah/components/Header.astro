---
import WhatsAppButton from './WhatsAppButton.astro';
import Photo from './Photo.astro';
import { photos } from '../data/photos';

// Âncoras absolutas: o mesmo cabeçalho é usado na home e nas páginas
// institucionais, onde "#equipe" sozinho não encontraria a seção.
const navLinks = [
  { href: "/tdah/#equipe", label: "Equipe" },
  { href: "/tdah/#como-funciona", label: "Como funciona" },
  { href: "/tdah/#faq", label: "FAQ" },
  { href: "/tdah/#localizacao", label: "Localização" },
];
---

<header>
  <a class="logo" href="/" aria-label="INSPEM — página inicial">
    <Photo photo={photos.logo} />
  </a>
  <nav aria-label="Navegação principal">
    {navLinks.map(link => (
      <a href={link.href}>{link.label}</a>
    ))}
    <WhatsAppButton text="WhatsApp" showIcon={false} target="_blank" rel="noopener" />
  </nav>
</header>
