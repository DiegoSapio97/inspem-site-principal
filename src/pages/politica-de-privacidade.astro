<thead>
<tr>
<th>Categoria</th>
<th>Para que serve</th>
<th>Precisa do seu consentimento?</th>
<th>Base legal</th>
</tr>
</thead>
<tbody>
<tr>
<td><strong>Essenciais</strong></td>
<td>Funcionamento e segurança do site, memória da sua escolha sobre cookies</td>
