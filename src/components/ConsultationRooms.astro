---
const rooms = [
  { src: '/assets/sala-1-inspem.avif', width: 1200, height: 901, caption: 'Sala 1' },
  { src: '/assets/sala-2-inspem.avif', width: 800, height: 600, caption: 'Sala 2' },
];
---

<div class="consultation-rooms" role="group" aria-label="Salas de atendimento">
  {rooms.map(room => (
    <figure>
      <img src={room.src} width={room.width} height={room.height} alt={`${room.caption} de atendimento da INSPEM`} loading="lazy" />
      <figcaption>{room.caption}</figcaption>
    </figure>
  ))}
</div>

<style>
  .consultation-rooms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    max-width: 1160px;
    margin-bottom: 24px;
    align-items: start;
  }
  figure {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  figcaption {
    padding: 12px 14px;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .consultation-rooms { grid-template-columns: minmax(0, 1fr); }
  }
</style>
